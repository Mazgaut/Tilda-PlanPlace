---
// Отдельная страница с формой обратной связи (Bitrix24, inline).
// Доступна по адресу /Tilda-PlanPlace/forma/
import SiteAnalytics from '../components/SiteAnalytics.astro';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Форма обратной связи — PlanPlace</title>
    <meta
      name="description"
      content="Свяжитесь с командой PlanPlace — заполните форму, и мы ответим на ваши вопросы."
    />
    <SiteAnalytics />
  </head>
  <body>
    <main class="wrap">
      <a class="back" href={base}>← В справочный центр</a>
      <h1>Связаться с нами</h1>
      <p class="lead">
        Заполните форму ниже — мы свяжемся с вами и поможем с настройкой PlanPlace.
      </p>

      {/* Bitrix24 — inline-форма */}
      <div class="form-host">
        <script is:inline data-b24-form="inline/6/3bht4b" data-skip-moving="true">
          (function(w,d,u){
          var s=d.createElement('script');s.async=true;s.src=u+'?'+(Date.now()/180000|0);
          var h=d.getElementsByTagName('script')[0];h.parentNode.insertBefore(s,h);
          })(window,document,'https://cdn-ru.bitrix24.ru/b32590620/crm/form/loader_6.js');
        </script>
      </div>
    </main>

    <style is:global>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        background: #fff;
        color: #1c1c1c;
        line-height: 1.6;
      }
      @media (prefers-color-scheme: dark) {
        body { background: #15171a; color: #e6e6e6; }
      }
      .wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }
      .back {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: #2563eb;
        text-decoration: none;
        font-size: 0.95rem;
      }
      .back:hover { text-decoration: underline; }
      h1 { font-size: 1.9rem; margin: 0 0 0.5rem; }
      .lead { margin: 0 0 2rem; opacity: 0.85; }
      .form-host { min-height: 200px; }
    </style>
  </body>
</html>
