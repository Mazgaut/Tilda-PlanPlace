---
/**
 * Локальное видео из public/media. В отличие от Video.astro не создаёт iframe
 * и подходит для коротких роликов, которые хранятся вместе со справкой.
 * Путь нормализуется под BASE_PATH: сборка работает и в GitHub Pages, и в
 * production в корне help.planplace.online.
 */
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;

const PREFIX = '/Tilda-PlanPlace';
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
let url = src;
if (base !== PREFIX) {
  if (url === PREFIX) url = base || '/';
  else if (url.startsWith(PREFIX + '/')) url = (base || '') + url.slice(PREFIX.length);
}
---

<video class="pp-local-video" controls preload="metadata" playsinline aria-label={title}>
  <source src={url} type="video/mp4" />
</video>

<style>
  .pp-local-video {
    display: block;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    margin: 1.25rem 0;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    background: #000;
  }
</style>
