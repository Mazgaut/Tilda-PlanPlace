---
/**
 * Карусель изображений (как галереи в Tilda).
 *
 * Изображения передаются как ВЛОЖЕННЫЙ markdown-контент (slot), а не пропсом —
 * это нужно для визуального редактора Keystatic (он не умеет MDX-import и
 * сложные JS-пропсы). Пример в статье:
 *
 *   <Carousel>
 *
 *   ![Подпись 1](../../assets/slug/02.jpg)
 *   ![Подпись 2](/Tilda-PlanPlace/media/slug/03.gif)
 *
 *   </Carousel>
 *
 * Относительные картинки Astro по-прежнему оптимизирует в WebP, GIF из public/
 * остаются анимированными. Все изображения попадают в HTML сразу — индексация и
 * чтение ИИ сохранены. Скрипт превращает каждое вложенное <img> в отдельный
 * слайд, поэтому высота карусели подстраивается под текущее изображение.
 * По клику картинка открывается в лайтбоксе с зумом (см. Lightbox.astro).
 */
---

<div class="pp-carousel" data-pp-carousel>
  <div class="pp-carousel__viewport"><slot /></div>
</div>

<!--
  Стили глобальные (is:global), а не scoped: слайды, кнопки и счётчик карусели
  создаются скриптом через createElement, поэтому НЕ получают scope-атрибут
  Astro — scoped-правила к ним не применились бы (картинки показались бы списком
  без переключения). Все селекторы под префиксом .pp-carousel — конфликтов нет.
-->
<style is:global>
  .pp-carousel {
    position: relative;
    margin: 1.25rem 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--sl-color-gray-6, #f1f1f1);
  }
  /* Высота контейнера = высота активного слайда (остальные вне потока). */
  .pp-carousel__viewport {
    position: relative;
    line-height: 0;
  }
  /* До инициализации скриптом картинки просто идут стопкой (видны для SEO). */
  .pp-carousel__viewport p {
    margin: 0;
  }
  .pp-carousel__viewport img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* После инициализации каждый слайд — отдельная figure, видна только активная. */
  .pp-carousel__slide {
    margin: 0;
    display: none;
  }
  .pp-carousel__slide.is-active {
    display: block;
  }
  .pp-carousel__slide img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .pp-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 2;
  }
  .pp-carousel__btn:hover { background: rgba(0, 0, 0, 0.8); }
  .pp-carousel__btn--prev { left: 0.6rem; }
  .pp-carousel__btn--next { right: 0.6rem; }
  .pp-carousel__counter {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.15rem 0.6rem;
    border-radius: 1rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 0.8rem;
    z-index: 2;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-pp-carousel]').forEach((root) => {
      if (root.dataset.ppReady) return;
      const viewport = root.querySelector<HTMLElement>('.pp-carousel__viewport');
      if (!viewport) return;

      // Все изображения из вложенного markdown превращаем в слайды.
      const imgs = Array.from(viewport.querySelectorAll<HTMLImageElement>('img'));
      if (!imgs.length) return;
      root.dataset.ppReady = '1';

      const slides = imgs.map((img, i) => {
        const fig = document.createElement('figure');
        fig.className = 'pp-carousel__slide' + (i === 0 ? ' is-active' : '');
        fig.dataset.index = String(i);
        fig.appendChild(img); // переносим картинку из обёртки <p> в слайд
        return fig;
      });
      viewport.replaceChildren(...slides);

      if (slides.length < 2) return;

      const prev = document.createElement('button');
      prev.className = 'pp-carousel__btn pp-carousel__btn--prev';
      prev.setAttribute('aria-label', 'Предыдущее изображение');
      prev.textContent = '‹';
      const next = document.createElement('button');
      next.className = 'pp-carousel__btn pp-carousel__btn--next';
      next.setAttribute('aria-label', 'Следующее изображение');
      next.textContent = '›';
      const counter = document.createElement('div');
      counter.className = 'pp-carousel__counter';
      const cur = document.createElement('span');
      cur.textContent = '1';
      counter.append(cur, document.createTextNode(` / ${slides.length}`));
      root.append(prev, next, counter);

      let idx = 0;
      const show = (i: number) => {
        idx = (i + slides.length) % slides.length;
        slides.forEach((s, j) => s.classList.toggle('is-active', j === idx));
        cur.textContent = String(idx + 1);
      };
      prev.addEventListener('click', () => show(idx - 1));
      next.addEventListener('click', () => show(idx + 1));

      // свайп на тачскрине
      let x0: number | null = null;
      root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) show(dx < 0 ? idx + 1 : idx - 1);
        x0 = null;
      });
    });
  }
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
