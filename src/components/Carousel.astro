---
/**
 * Карусель изображений (как галереи в Tilda).
 *
 * Показывает один слайд за раз, поэтому высота карусели подстраивается под
 * текущее изображение: на горизонтальном — ниже, на вертикальном — выше,
 * ширина постоянна, кнопки управления остаются по вертикальному центру.
 *
 * Все слайды присутствуют в HTML сразу — индексация и чтение ИИ сохранены.
 * По клику изображение открывается в лайтбоксе с зумом (см. Lightbox.astro).
 *
 * images: { src, alt }, где src — импортированное изображение (оптимизируется
 * в WebP) или строка-URL (например, GIF из public/, чтобы сохранить анимацию).
 */
import { Image } from 'astro:assets';

interface Slide {
  src: ImageMetadata | string;
  alt?: string;
}
const { images = [] as Slide[] } = Astro.props;
---

<div class="pp-carousel" data-pp-carousel>
  <div class="pp-carousel__viewport">
    {images.map((img: Slide, i: number) => (
      <figure class={`pp-carousel__slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
        {typeof img.src === 'string'
          ? <img src={img.src} alt={img.alt ?? ''} loading="lazy" />
          : <Image src={img.src} alt={img.alt ?? ''} />}
      </figure>
    ))}
  </div>

  {images.length > 1 && (
    <>
      <button class="pp-carousel__btn pp-carousel__btn--prev" aria-label="Предыдущее изображение">‹</button>
      <button class="pp-carousel__btn pp-carousel__btn--next" aria-label="Следующее изображение">›</button>
      <div class="pp-carousel__counter"><span data-pp-current>1</span> / {images.length}</div>
    </>
  )}
</div>

<style>
  .pp-carousel {
    position: relative;
    margin: 1.25rem 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--sl-color-gray-6, #f1f1f1);
  }
  /* Высота контейнера = высота активного слайда (остальные вне потока). */
  .pp-carousel__viewport {
    position: relative;
    line-height: 0;
  }
  .pp-carousel__slide {
    margin: 0;
    display: none;
  }
  .pp-carousel__slide.is-active {
    display: block;
  }
  .pp-carousel__slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .pp-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 2;
  }
  .pp-carousel__btn:hover { background: rgba(0, 0, 0, 0.8); }
  .pp-carousel__btn--prev { left: 0.6rem; }
  .pp-carousel__btn--next { right: 0.6rem; }
  .pp-carousel__counter {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.15rem 0.6rem;
    border-radius: 1rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 0.8rem;
    z-index: 2;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-pp-carousel]').forEach((root) => {
      if (root.dataset.ppReady) return;
      root.dataset.ppReady = '1';
      const slides = Array.from(root.querySelectorAll<HTMLElement>('.pp-carousel__slide'));
      const prev = root.querySelector<HTMLElement>('.pp-carousel__btn--prev');
      const next = root.querySelector<HTMLElement>('.pp-carousel__btn--next');
      const cur = root.querySelector<HTMLElement>('[data-pp-current]');
      let idx = 0;
      const show = (i: number) => {
        idx = (i + slides.length) % slides.length;
        slides.forEach((s, j) => s.classList.toggle('is-active', j === idx));
        if (cur) cur.textContent = String(idx + 1);
      };
      prev?.addEventListener('click', () => show(idx - 1));
      next?.addEventListener('click', () => show(idx + 1));
      // свайп на тачскрине
      let x0: number | null = null;
      root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) show(dx < 0 ? idx + 1 : idx - 1);
        x0 = null;
      });
    });
  }
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
