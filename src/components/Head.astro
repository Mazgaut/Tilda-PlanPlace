---
// Переопределение стандартного <Head> Starlight.
// Рендерит весь штатный head, а затем добавляет наши сайтовые
// счётчики и виджеты из SiteAnalytics.astro — на каждой странице.
import Default from '@astrojs/starlight/components/Head.astro';
import SiteAnalytics from './SiteAnalytics.astro';
import StructuredData from './StructuredData.astro';
import Lightbox from './Lightbox.astro';
---

<Default><slot /></Default>
{/* Иконка для iOS/Android-закладок (favicon.ico подключает Starlight через опцию favicon) */}
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
{/* Фирменный шрифт PlanPlace — Roboto */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
/>
<StructuredData />
<Lightbox />
<SiteAnalytics />
<script is:inline>
(function () {
  var key = 'pp_site';
  var param = new URLSearchParams(window.location.search).get('site');
  if (param) sessionStorage.setItem(key, param);
  var siteValue = sessionStorage.getItem(key);
  if (!siteValue) return;

  function fillFields() {
    document.querySelectorAll(
      '[name="b24-form-field-1"], #b24-form-field-1'
    ).forEach(function (field) {
      if (field.value === '') {
        field.value = siteValue;
        field.dispatchEvent(new Event('input', { bubbles: true }));
        field.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }

  // MutationObserver — ловит появление формы в DOM при любом сценарии
  var observer = new MutationObserver(fillFields);
  observer.observe(document.documentElement, { childList: true, subtree: true });

  // Polling после клика на кнопку Bitrix24 — popup рендерится с задержкой,
  // и MutationObserver иногда срабатывает раньше, чем поле готово к записи
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest
      ? e.target.closest('[data-b24-form], .b24-form-btn, .pp-cta__btn')
      : null;
    if (!btn) return;
    var attempts = 0;
    var timer = setInterval(function () {
      fillFields();
      if (++attempts >= 30) clearInterval(timer);
    }, 100);
  }, true);

  document.addEventListener('DOMContentLoaded', fillFields);
})();
</script>
