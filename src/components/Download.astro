---
/**
 * Кнопка-ссылка для скачивания файла-примера (Excel-шаблон, архив с 3D-моделью и т. п.).
 * Вынесена в компонент, чтобы блок редактировался в Keystatic, а не сырым HTML.
 *
 * Тип файла определяется по расширению в href, поэтому схема Keystatic
 * (href + label) остаётся неизменной:
 *   - .xls/.xlsx — показываем иконку Excel из public (как было раньше);
 *   - остальное (.zip, .fbx, .blend …) — встроенная иконка скачивания.
 *
 * Пропсы: href — адрес файла, label — подпись кнопки.
 */
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Скачать пример' } = Astro.props;

const isExcel = /\.xlsx?($|\?)/i.test(href);
const excelIcon = `${import.meta.env.BASE_URL}media/prays-listy/excel.png`.replace('//media', '/media');
---

<a class="pp-download" href={href} download target="_blank" rel="noopener">
  {isExcel ? (
    <img src={excelIcon} alt="" width="28" height="28" />
  ) : (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </svg>
  )}
  <span>{label}</span>
</a>
