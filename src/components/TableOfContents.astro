---
// Переопределение правой панели «На этой странице».
// Рендерит штатное оглавление и добавляет соцсети после него.
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const socials = [
  { href: 'https://www.youtube.com/@planplace9272', alt: 'youtube', icon: 'youtube' },
  { href: 'https://rutube.ru/channel/52167970/', alt: 'RUTUBE', icon: 'rutube' },
  { href: 'https://vk.com/planplace', alt: 'vkontakte', icon: 'vk' },
  { href: 'https://t.me/planplace', alt: 'telegram', icon: 'telegram' },
];
---

<div class="pp-toc-wrapper">
  <div class="pp-toc-default">
    <Default {...Astro.props}><slot /></Default>
  </div>

  <div class="pp-socials" aria-label="Соцсети и видео-каналы PlanPlace">
    {socials.map((s) => (
      <a class="pp-social-link" href={s.href} target="_blank" rel="noopener" aria-label={s.alt}>
        <img class="pp-social-icon pp-social-icon--dark" src={`${base}/social/${s.icon}.png`} alt={s.alt} width="28" height="28" loading="lazy" />
        <img class="pp-social-icon pp-social-icon--light" src={`${base}/social/${s.icon}-light.png`} alt="" width="28" height="28" loading="lazy" aria-hidden="true" />
      </a>
    ))}
  </div>
</div>
