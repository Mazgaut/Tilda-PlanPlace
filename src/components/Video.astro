---
/**
 * Встраиваемое видео (VK Видео, YouTube и т. п.) адаптивным блоком 16:9.
 * Вынесено в компонент, чтобы вставка редактировалась в Keystatic, а не
 * сырым <iframe>.
 *
 * Пропсы: src — адрес плеера (атрибут src у iframe).
 */
interface Props {
  src: string;
}
const { src } = Astro.props;
---

<div class="pp-video">
  <iframe
    src={src}
    loading="lazy"
    allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
  .pp-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 1.25rem 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  .pp-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
